= Internal Factions of the SPD

{!<span class="faction-left">Parliamentary Left</span><br>!}Strength: [+ left_strength : strength +]{!<br>!}Dissent: [+ left_dissent : dissent +]

{!<span class="faction-center">Netzwerk Berlin</span><br>!}Strength: [+ center_strength : strength +]{!<br>!}Dissent: [+ center_dissent : dissent +]

{!<span class="faction-right">Seeheimer Kreis</span><br>!}Strength: [+ right_strength : strength +]{!<br>!}Dissent: [+ right_dissent : dissent +]

{!<span class="faction-labor">Union Wing</span><br>!}Strength: [+ labor_strength : strength +]{!<br>!}Dissent: [+ labor_dissent : dissent +]

[? if socialfascist_formed > 0 : {!<span class="faction-socialfascist">Social-Fascists:</span><br>!}Strength: [+ neorevisionist_strength : strength +]{!<br>!}Dissent: [+ neorevisionist_dissent : dissent +] ?]

@security
on-arrival: {!
Q.defence_spending_2 = (Q.defence_spending || 0).toFixed(1);
Q.democracy_support_disp = Math.round(Q.democracy_support || 0);
Q.socdem_support_disp = Math.round(Q.socdem_support || 0);
Q.nationalism_support_disp = Math.round(Q.nationalism_support || 0);
!}

= Security cabinet

Defence minister: [+ defence_minister +] ([+ defence_minister_party +])

Interior minister: [+ interior_minister +] ([+ interior_minister_party +])

= Armed forces

{!<span class="tooltip-text" title="The German armed forces.">Bundeswehr</span>!}: [+ bundeswehr_strength +] thousand troops.

Bundeswehr loyalty: [+ bundeswehr_loyalty : loyalty +]

Bundeswehr readiness: [+ bundeswehr_readiness +]/4

Defence spending: [+ defence_spending_2 +]% of GDP (NATO target: [+ defence_target +]%)

Military service: [? if wehrdienst == 0 : voluntary ?][? if wehrdienst == 1 : compulsory registration ?][? if wehrdienst == 2 : conscription ?]

= Police

{!<span class="tooltip-text" title="The federal police, responsible for borders, railways and airports.">Bundespolizei</span>!}: [+ bundespolizei_strength +] thousand members.

Bundespolizei loyalty: [+ bundespolizei_loyalty : loyalty +]

{!<span class="tooltip-text" title="The police forces of the 16 Länder.">Landespolizei</span>!}: [+ landespolizei_strength +] thousand members.

Landespolizei loyalty: [+ landespolizei_loyalty : loyalty +]

Border controls: [? if border_controls : active ?][? if border_controls == 0 : lifted ?]

= Domestic intelligence

{!<span class="tooltip-text" title="The Bundesamt für Verfassungsschutz, the domestic intelligence service.">Verfassungsschutz</span>!} loyalty: [+ verfassungsschutz_loyalty : loyalty +]

Verfassungsschutz powers: [+ verfassungsschutz_power +]/4

AfD status: [? if afd_classification == 0 : not observed ?][? if afd_classification == 1 : suspected case ?][? if afd_classification == 2 : confirmed extremist (suspended) ?][? if afd_classification == 3 : confirmed extremist ?][? if afd_classification == 4 : ban proceedings ?]

Extremist threat: [? if extremism_threat == 0 : low ?][? if extremism_threat == 1 : moderate ?][? if extremism_threat == 2 : elevated ?][? if extremism_threat == 3 : high ?][? if extremism_threat == 4 : critical ?]

= Public mood

Support for democracy: [+ democracy_support_disp +]%

Support for social democracy: [+ socdem_support_disp +]%

Nationalism: [+ nationalism_support_disp +]%

@polls
on-arrival: {!
// Work the polls out here too, so the tab is filled from the first turn.
// Same maths as post_event; it only writes *_poll, *_bar and *_display values.
var norm = {};
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        class_votes += Math.max(Q[c+'_'+party] || 0, 0);
    }
    for (var party of Q.parties) {
        norm[c+'_'+party] = class_votes > 0 ? 100*Math.max(Q[c+'_'+party] || 0, 0)/class_votes : 0;
        Q[c+'_'+party+'_display'] = Math.round(norm[c+'_'+party]);
    }
}
var total_support = 0;
var support = {};
for (var party of Q.parties) {
    support[party] = 0;
    for (var c of Q.classes) {
        support[party] += (Q[c] || 0)*norm[c+'_'+party];
    }
    total_support += support[party];
}
for (var party of Q.parties) {
    Q[party+'_poll'] = total_support > 0 ? Math.round(1000*support[party]/total_support)/10 : 0;
    // the bar is full at 50%
    Q[party+'_bar'] = Math.min(100, Q[party+'_poll']*2);
}
// CDU/CSU together (used while csu_split = 0)
Q.union_poll = Math.round(10*((Q.cdu_poll || 0) + (Q.csu_poll || 0)))/10;
Q.union_bar = Math.min(100, Q.union_poll*2);
for (var c of Q.classes) {
    Q[c+'_union_display'] = Math.round((norm[c+'_cdu'] || 0) + (norm[c+'_csu'] || 0));
}
Q.democracy_support_disp = Math.round(Q.democracy_support || 0);
!}

= Opinion Polls

{!<div class="poll-row"><span class="poll-name ideology-tooltip-wrap seat spd" data-tip="spd" tabindex="0">SPD</span><span class="poll-track"><span class="poll-fill spd" style="width:!}[+ spd_bar +]{!%"></span></span><span class="poll-pct">!}[+ spd_poll +]{!%</span></div>!}

[? if csu_split = 0 : {!<div class="poll-row"><span class="poll-name ideology-tooltip-wrap seat cdu" data-tip="cducsu" tabindex="0">CDU/CSU</span><span class="poll-track"><span class="poll-fill union" style="width:!}[+ union_bar +]{!%"></span></span><span class="poll-pct">!}[+ union_poll +]{!%</span></div>!} ?]

[? if csu_split = 1 : {!<div class="poll-row"><span class="poll-name ideology-tooltip-wrap seat cdu" data-tip="cdu" tabindex="0">CDU</span><span class="poll-track"><span class="poll-fill cdu" style="width:!}[+ cdu_bar +]{!%"></span></span><span class="poll-pct">!}[+ cdu_poll +]{!%</span></div>!} ?]

