title: Status
new-page: true
is-special: true
on-arrival: {!
Q.cducsu_r = Math.round(((Q.cdu_r || 0) + (Q.csu_r || 0))*10)/10;
for (var p of ['linke','bsw','greens','spd','fdp','cducsu','afd','ssw','other']) {
    Q[p + '_r_2'] = (Q[p + '_r'] || 0).toFixed(1);
}
if (Q.unemployed) {
    Q.unemployed_2 = Q.unemployed.toFixed(1);
}
if (Q.inflation) {
    Q.inflation_2 = Q.inflation.toFixed(1);
}
Q.economic_growth_2 = '0';
if (Q.economic_growth) {
    Q.economic_growth_2 = Q.economic_growth.toFixed(1);
}
!}

= Status

[+ month : month +] [+ year +]

Resources available: [+ resources +]

SPD position: [? if spd_toleration : toleration ?][? if spd_in_government : in government - ?][? if spd_toleration == 0 and spd_in_government == 0 and spd_caretaker == 0 : opposition ?][? if spd_caretaker : caretaker government ?]
[? if in_weimar_coalition and spd_in_government: Weimar Coalition ?][? if in_grand_coalition and spd_in_government: Grand Coalition ?][? if in_popular_front and spd_in_government: Popular Front ?][? if in_left_front and spd_in_government: Left Front ?][? if in_spd_majority and spd_in_government: SPD majority ?][? if in_minority_government and spd_in_government: minority government ?][? if in_emergency_government and spd_in_government: emergency government ?]

[? if spd_in_government and not in_spd_majority : Coalition dissent: [+ coalition_dissent : coalition_dissent +] ?]

Internal dissent: [+ dissent_percent : dissent +]

= Government

President: {!<span class="seat other">!}[+ president +]{!</span>!}

Chancellor: {!<span class="seat cdu">!}[+ chancellor +]{!</span>!} ({!<span class="seat cdu">!}[+ chancellor_party +]{!</span>!})

Bundestag composition:

[? if linke_r > 0 : {!<span class="seat linke">Linke</span>!}: [+ linke_r_2 +]% ?]
[? if bsw_r > 0 : {!<span class="seat bsw">BSW</span>!}: [+ bsw_r_2 +]% ?]
[? if greens_r > 0 : {!<span class="seat greens">Greens</span>!}: [+ greens_r_2 +]% ?]
[? if spd_r > 0 : {!<span class="seat spd">SPD</span>!}: [+ spd_r_2 +]% ?]
[? if fdp_r > 0 : {!<span class="seat fdp">FDP</span>!}: [+ fdp_r_2 +]% ?]
[? if cducsu_r > 0 : {!<span class="seat cdu">CDU/CSU</span>!}: [+ cducsu_r_2 +]% ?]
[? if afd_r > 0 : {!<span class="seat afd">AfD</span>!}: [+ afd_r_2 +]% ?]
[? if ssw_r > 0 : {!<span class="seat ssw">SSW</span>!}: [+ ssw_r_2 +]% ?]
[? if other_r > 0 : {!<span class="seat other">Others</span>!}: [+ other_r_2 +]% ?]

Next election: [+ next_election_month : month +] [+ next_election_year +]

= Economics

[? if spd_in_government = 1 : Budget: [+ budget +] ?]

Inflation: [+ inflation_2 +]%

Economic growth: [+ economic_growth_2 +]%

Unemployment: [+ unemployed_2 +]% 


# = Public Opinion

@politics

= Inter-party Relations

{!<span class="seat linke">Linke</span>!}: [+ linke_relation : relationships +]

{!<span class="seat bsw">BSW</span>!}: [+ bsw_relation : relationships +]

{!<span class="seat greens">Greens</span>!}: [+ greens_relation : relationships +]

