{!<div class="poll-row"><span class="poll-name ideology-tooltip-wrap seat greens" data-tip="greens" tabindex="0">Grüne</span><span class="poll-track"><span class="poll-fill greens" style="width:!}[+ greens_bar +]{!%"></span></span><span class="poll-pct">!}[+ greens_poll +]{!%</span></div>!}

{!<div class="poll-row"><span class="poll-name ideology-tooltip-wrap seat linke" data-tip="linke" tabindex="0">Linke</span><span class="poll-track"><span class="poll-fill linke" style="width:!}[+ linke_bar +]{!%"></span></span><span class="poll-pct">!}[+ linke_poll +]{!%</span></div>!}

