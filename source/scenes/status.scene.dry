{!<details class="poll-group"><summary><b>New middle class</b><span class="poll-stack"><span class="poll-fill linke" style="width:!}[+ middle_class_linke_display +]{!%"></span><span class="poll-fill spd" style="width:!}[+ middle_class_spd_display +]{!%"></span><span class="poll-fill greens" style="width:!}[+ middle_class_greens_display +]{!%"></span><span class="poll-fill fdp" style="width:!}[+ middle_class_fdp_display +]{!%"></span><span class="poll-fill union" style="width:!}[+ middle_class_union_display +]{!%"></span><span class="poll-fill bsw" style="width:!}[+ middle_class_bsw_display +]{!%"></span><span class="poll-fill afd" style="width:!}[+ middle_class_afd_display +]{!%"></span></span></summary><div class="poll-grid"><span><span class="poll-grid-name ideology-tooltip-wrap seat spd" data-tip="spd" tabindex="0">SPD</span> !}[+ middle_class_spd_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat cdu" data-tip="cducsu" tabindex="0">CDU/CSU</span> !}[+ middle_class_union_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat afd" data-tip="afd" tabindex="0">AfD</span> !}[+ middle_class_afd_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat greens" data-tip="greens" tabindex="0">Grüne</span> !}[+ middle_class_greens_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat linke" data-tip="linke" tabindex="0">Linke</span> !}[+ middle_class_linke_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat fdp" data-tip="fdp" tabindex="0">FDP</span> !}[+ middle_class_fdp_display +]{!%</span><span><span class="poll-grid-name ideology-tooltip-wrap seat bsw" data-tip="bsw" tabindex="0">BSW</span> !}[+ middle_class_bsw_display +]{!%</span><span><span class="poll-grid-name">Others</span> !}[+ middle_class_other_display +]{!%</span>!}[? if sapd_formed : {!<span><b>SAPD</b> !}[+ middle_class_sapd_display +]{!%</span>!} ?][? if srpd_formed : {!<s