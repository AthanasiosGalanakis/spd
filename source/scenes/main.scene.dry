title: Next month
set-bg: img/BundesTag.jpg
is-hand: true
on-arrival: {!
if (Q.advisor_action_timer <= 0) {
    Q.pinnedCardsDescription = 'Advisors - an action is available.';
} else if (Q.advisor_action_timer == 1) {
    Q.pinnedCardsDescription = 'Advisors - next action available in 1 month.';
} else {
    Q.pinnedCardsDescription = 'Advisors - next action available in ' + Q.advisor_action_timer + ' months.';
}
!}
max-cards: 4

<div class="leader-row">
<div class="leader-card">
<img class="leader-portrait" src="[+ img_spd_leader +]">
<div class="leader-name">[+ name_spd_leader +]</div>
<div class="leader-role">Party Co-Chair</div>
</div>
<div class="leader-card">
<img class="leader-portrait" src="[+ img_spd_leader_2 +]">
<div class="leader-name">[+ name_spd_leader_2 +]</div>
<div class="leader-role">Party Co-Chair</div>
</div>
</div>

- @party
- @govt
- #advisor
- @shuffle_leadership_pinned

@party
title: Party Affairs
card-image: img/Vorwaerts_nr_1.png
is-deck: true

- #party_affairs

@govt
title: Government Affairs
view-if: spd_in_government = 1
card-image: img/reichstag_2.jpg
is-deck: true

- #govt_affairs